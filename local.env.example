QGIS := /Applications/QGIS.app
QGIS_PREFIX_PATH := $(QGIS)/Contents/MacOS

# Path on the ArcGIS Pro machine where project folders are copied.
# Used to rewrite shapefile paths in generated .lyrx files.
# Forward slashes work on Windows; no trailing slash.
# ARCGIS_WORKSPACE_ROOT := C:/Users/you/GIS
